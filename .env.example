# --- Discord ---
DISCORD_TOKEN=
# Discord user/role IDs allowed to run bot commands (comma-separated).
# Leave empty for the default behaviour defined in discord/bot/commands.py

# --- Telegram ---
TELEGRAM_HTTP_API_TOKEN=
# Optional: base URL of a self-hosted Telegram "HTTP API" server (Bot API only)
# when you are not using the official api.telegram.org endpoint.
TELEGRAM_HTTP_API_BASE_URL=
# Full public https URL Telegram posts updates to, ending in /telegram/webhook.
# The webhook is (re-)registered on every startup, so change the link here + restart.
TELEGRAM_WEBHOOK_URL=
# Optional secret token Telegram sends as X-Telegram-Bot-Api-Secret-Token on each update.
TELEGRAM_WEBHOOK_SECRET=

# --- Webhook server ---
# Secret the originating endpoint sends as: Authorization: Bearer <WEBHOOK_SECRET>
WEBHOOK_SECRET=
# Per-IP rate limits (slowapi format, e.g. "10/minute")
WEBHOOK_RATE_LIMIT=10/minute
HEALTH_RATE_LIMIT=30/minute

# --- Database (Supabase Postgres) ---
# First run: use the postgres owner URL so tables get created (CREATE TABLE IF NOT EXISTS).
# Afterwards: switch to a DML-only user (this URL); startup skips DDL when tables exist.
# Note: for Supabase use the direct port-5432 URL (asyncpg does not work with pgbouncer transaction mode).
DATABASE_URL=postgresql+asyncpg://postgres:PASSWORD@db.xxxx.supabase.co:5432/postgres

# DML-only role. When set, the first boot that creates our tables also runs:
#   GRANT SELECT ON public.notification_posts
#   GRANT SELECT, INSERT, UPDATE, DELETE ON our tables
#   GRANT USAGE, SELECT ON the id sequence
DB_APP_USER=

# --- Discord bot ---
# Destination tracked in public.notification_posts is read-only for the bot.
# Set NOTIFICATION_POOL_SIZE for concurrent DB access if needed.